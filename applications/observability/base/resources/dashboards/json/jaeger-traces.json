{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "Browse traces in the selected time range and inspect a trace by selecting its ID.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "text",
        "uid": "-- Dashboard --"
      },
      "description": "Select a trace ID to open that trace in the panel below. Results follow the dashboard time range.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "Choose a trace ID from the table below to load its spans. Adjust the dashboard time range to browse other traces.",
        "mode": "markdown"
      },
      "title": "How to use",
      "type": "text"
    },
    {
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "jaeger-api"
      },
      "description": "Traces returned by Jaeger's v3 search API for the selected dashboard time range.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "links": [
            {
              "title": "View trace",
              "url": "/d/jaeger-traces/jaeger-traces?var-trace_id=${__value.raw}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 3,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "columns": [
            {
              "selector": "traceId",
              "text": "Trace ID",
              "type": "string"
            }
          ],
          "format": "table",
          "parser": "backend",
          "refId": "A",
          "root_selector": "$map($distinct($.result.resourceSpans.scopeSpans.spans.traceId), function($id) {{\"traceId\": $id}})",
          "source": "url",
          "type": "json",
          "url": "/api/v3/traces",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "query.start_time_min",
                "value": "${__timeFrom:date:iso}"
              },
              {
                "key": "query.start_time_max",
                "value": "${__timeTo:date:iso}"
              },
              {
                "key": "query.search_depth",
                "value": "100"
              }
            ]
          }
        }
      ],
      "title": "Traces in time range",
      "type": "table"
    },
    {
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "description": "Inspect the spans and timing for the trace selected from the table above.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "query": "$trace_id",
          "refId": "A"
        }
      ],
      "title": "Trace details",
      "type": "traces"
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "jaeger",
    "tracing"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Trace ID to retrieve from Jaeger",
        "hide": 2,
        "label": "Trace ID",
        "name": "trace_id",
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Jaeger Traces",
  "uid": "jaeger-traces",
  "version": 1,
  "weekStart": ""
}
