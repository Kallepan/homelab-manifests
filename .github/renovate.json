{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub raw content URLs in Kustomize manifests",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s*\\n\\s*-\\s*https?://raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?<currentValue>[^/]+)/"
      ]
    },
    {
      "customType": "regex",
      "description": "Update GitHub remote Kustomize resources",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s*\\n\\s*-\\s*https?://github\\.com/[^/]+/[^/]+//[^?]+\\?ref=(?<currentValue>v?[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update GitHub release download URLs in Kustomize manifests",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$/"
      ],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s*\\n",
        "https?://github\\.com/[^/]+/[^/]+/releases/download/(?<currentValue>[^/]+)/"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the GitLab chart version managed by the GitLab operator",
      "managerFilePatterns": [
        "/^applications/gitlab/base/resources/gitlab\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s+version:\\s*[\\\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\\\"]?\\s*$"
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "gitlab",
      "registryUrlTemplate": "https://charts.gitlab.io",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Gateway API bundle version",
      "managerFilePatterns": [
        "/^applications/networking/base/resources/gateway-api\\.yaml$/"
      ],
      "matchStrings": [
        "gateway\\.networking\\.k8s\\.io/bundle-version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Renovate CLI version used to validate the configuration",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "--package\\s+renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
      "versioningTemplate": "npm"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/(^|/)(application(?:-[^/]+)?|all-apps)\\.ya?ml$/",
      "/^applications/istio/base/resources/(?:istio-base|istio-cni|istiod|ztunnel)\\.ya?ml$/",
      "/^applications/observability/base/resources/prometheus-blackbox-exporter\\.ya?ml$/",
      "/^applications/gitlab/base/resources/valkey\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^applications/(?:argocd|cert-manager|cnpg-operator|external-secrets|external-secrets-operator|gitlab|gitlab-operator|gitlab-runner|grafana-operator|homepage|istio|it-tools|keycloak|keycloak-operator|local-path-storage|mattermost|mattermost-operator|metrics-server|oauth2-proxy|observability|olm|opentelemetry-operator|pgadmin|reloader|sonarqube)/.+\\.ya?ml$/",
      "/^_deprecated/.+\\.ya?ml$/"
    ]
  },
  "pre-commit": {
    "enabled": true,
    "managerFilePatterns": [
      "/(^|/)\\.pre-commit-config\\.ya?ml$/"
    ]
  },
  "helmv3": {
    "managerFilePatterns": [
      "/(^|/)Chart\\.ya?ml$/"
    ]
  },
  "assignees": [
    "Kallepan"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 10,
  "semanticCommits": "enabled",
  "gitAuthor": "Renovate Bot <bot@home.arpa>"
}
