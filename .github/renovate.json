{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update vendored charts from HTTP Helm repositories",
      "managerFilePatterns": [
        "/^applications\\/[^/]+\\/charts\\/[^/]+\\/Chart\\.yaml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "(?m)^# Vendored from (?<registryUrl>https?:\\/\\/[^\\r\\n]+)[\\s\\S]*$",
        "(?m)^name:[ \\t]*[\"']?(?<depName>[A-Za-z0-9._-]+)[\"']?[ \\t]*(?:#.*)?[\\s\\S]*$",
        "(?m)^version:[ \\t]*[\"']?(?<currentValue>[^ \\t\\r\\n\"'#]+)[\"']?[ \\t]*(?:#.*)?$"
      ],
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Update vendored charts from OCI registries",
      "managerFilePatterns": [
        "/^applications\\/[^/]+\\/charts\\/[^/]+\\/Chart\\.yaml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "(?m)^# Vendored from oci:\\/\\/(?<registryHost>[^/]+)\\/(?<repositoryPath>[^\\r\\n]+)[\\s\\S]*$",
        "(?m)^name:[ \\t]*[\"']?(?<depName>[A-Za-z0-9._-]+)[\"']?[ \\t]*(?:#.*)?[\\s\\S]*$",
        "(?m)^version:[ \\t]*[\"']?(?<currentValue>[^ \\t\\r\\n\"'#]+)[\"']?[ \\t]*(?:#.*)?$"
      ],
      "depNameTemplate": "{{depName}}",
      "packageNameTemplate": "{{registryHost}}/{{repositoryPath}}/{{depName}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Update GitHub raw content URLs in Kustomize manifests",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s*\\n\\s*-\\s*https?://raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?<currentValue>[^/]+)/"
      ]
    },
    {
      "customType": "regex",
      "description": "Update GitHub remote Kustomize resources",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s*\\n\\s*-\\s*https?://github\\.com/[^/]+/[^/]+//[^?]+\\?ref=(?<currentValue>v?[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update GitHub release download URLs in Kustomize manifests",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.ya?ml$/"
      ],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s*\\n",
        "https?://github\\.com/[^/]+/[^/]+/releases/download/(?<currentValue>[^/]+)/"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the GitLab chart version managed by the GitLab operator",
      "managerFilePatterns": [
        "/^applications/gitlab/base/resources/gitlab\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s+version:\\s*[\\\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\\\"]?\\s*$"
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "gitlab",
      "registryUrlTemplate": "https://charts.gitlab.io",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the default GitLab Runner job image",
      "managerFilePatterns": [
        "/^applications/gitlab-runner/base/resources/application\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image\\s*=\\s*\\\"alpine:(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"\\s*$"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Gateway API bundle version",
      "managerFilePatterns": [
        "/^applications/networking/base/resources/gateway-api\\.yaml$/"
      ],
      "matchStrings": [
        "gateway\\.networking\\.k8s\\.io/bundle-version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Renovate CLI version used for config validation",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "--package\\s+renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update the Devbox schema version",
      "managerFilePatterns": [
        "/^devbox\\.json$/"
      ],
      "matchStrings": [
        "https?://raw\\.githubusercontent\\.com/jetify-com/devbox/(?<currentValue>\\d+\\.\\d+\\.\\d+)/\\.schema/devbox\\.schema\\.json"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jetify-com/devbox",
      "versioningTemplate": "semver"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "applications/**/*.yaml",
      "applications/**/*.yml",
      "!applications/networking/base/resources/gateway-api.yaml"
    ]
  },
  "pre-commit": {
    "enabled": true,
    "managerFilePatterns": [
      "/(^|/)\\.pre-commit-config\\.ya?ml$/"
    ]
  },
  "helmv3": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Avoid partial Kubernetes and Helm values updates inside vendored charts",
      "matchManagers": [
        "kubernetes",
        "helm-values"
      ],
      "matchFileNames": [
        "applications/*/charts/**"
      ],
      "enabled": false
    },
    {
      "description": "Refresh the complete vendored chart when its upstream version changes",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "applications/*/charts/*/Chart.yaml"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bash scripts/refresh-vendored-helm-charts.sh"
        ],
        "fileFilters": [
          "applications/*/charts/*/**"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "ignorePaths": [
    "_deprecated/**"
  ],
  "assignees": [
    "Kallepan"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "semanticCommits": "enabled",
  "gitAuthor": "Renovate Bot <bot@home.arpa>",
  "prCreation": "immediate"
}
