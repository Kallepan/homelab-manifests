{
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)kustomization\\.ya?ml$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s*\\n\\s*-\\s*https?://[^/]+/[^/]+/[^/]+/(?<currentValue>[^/]+)/"
      ]
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/(^|/)(application(?:-[^/]+)?|all-apps)\\.ya?ml$/"
    ]
  },
  "helmv3": {
    "managerFilePatterns": [
      "/(^|/)Chart\\.ya?ml$/"
    ]
  },
  "assignees": [
    "Kallepan"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 10,
  "semanticCommits": "enabled",
  "gitAuthor": "Renovate Bot <bot@home.arpa>"
}
