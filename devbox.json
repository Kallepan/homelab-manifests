{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.20.0/.schema/devbox.schema.json",
  "packages": [
    "kubernetes-helm@4.3.1",
    "kubectl@1.37.2",
    "kustomize@5.8.3",
    "just@1.59.0",
    "prek@0.5.7",
    "yamllint@1.37.1",
